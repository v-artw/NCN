# Copy to .env.edge_scout_schedule after human approval of the calendar candidate.
EDGE_SCOUT_DATA_ROOT=/Users/artx/Local/Git/Stock/NCN/PFrontStockData
EDGE_SCOUT_CONFIG=/Users/artx/Local/Git/Stock/NCN/yaml/edge_scout_v1.yaml
EDGE_SCOUT_OUTPUT_ROOT=/Users/artx/Local/Git/Stock/NCN/output/edge_scout_production
EDGE_SCOUT_CALENDAR=/path/to/human-reviewed-calendar.txt
EDGE_SCOUT_CALENDAR_SHA256=<approved-calendar-sha256>
EDGE_SCOUT_CALENDAR_APPROVAL=/path/to/calendar-approval.json
EDGE_SCOUT_DOWNLOAD_WORKERS=4
EDGE_SCOUT_DOWNLOAD_MAX_FAILURE_RATE=0.10
EDGE_SCOUT_MINIMUM_LATEST_COVERAGE=0.95
EDGE_SCOUT_SCHEDULE_TIMEOUT_SECONDS=7200
EDGE_SCOUT_SCHEDULE_RETAIN_LOGS=30
# Optional HTTPS webhook. Keep the real value only in the ignored .env file.
# EDGE_SCOUT_ALERT_WEBHOOK_URL=https://example.invalid/webhook
